msgid "An account with this email already exists."
msgstr "يوجد حساب بهذا البريد الإلكتروني بالفعل."

msgid "Invalid email or password."
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة."

msgid "Invalid or revoked API key."
msgstr "مفتاح API غير صالح أو أُلغي."

#, python-format
msgid "Country %(value)s is not supported."
msgstr "الدولة %(value)s غير مدعومة."

#, python-format
msgid "Subdivision %(value)s is not supported for %(country)s."
msgstr "المنطقة %(value)s غير مدعومة في %(country)s."

#, python-format
msgid "Language %(value)s is not supported for %(country)s."
msgstr "اللغة %(value)s غير مدعومة في %(country)s."

#, python-format
msgid "Categories not supported for %(country)s: %(value)s."
msgstr "فئات غير مدعومة في %(country)s: %(value)s."

#, python-format
msgid "Years must be between %(min)s and %(max)s."
msgstr "يجب أن تكون السنوات بين %(min)s و%(max)s."

msgid "Result falls outside the supported year range."
msgstr "النتيجة خارج نطاق السنوات المدعومة."

#, python-format
msgid "Your plan allows at most %(max)s active API keys."
msgstr "تسمح خطتك بـ%(max)s من مفاتيح API النشطة كحد أقصى."

#, python-format
msgid "Year must be between %(min)s and %(max)s."
msgstr "يجب أن تكون السنة بين %(min)s و%(max)s."

msgid "Give exactly one of country or calendar."
msgstr "حدّد إما الدولة أو التقويم، وليس كليهما."

msgid "Not allowed with calendar; the calendar defines it."
msgstr "غير مسموح به مع التقويم؛ فالتقويم يحدده."

msgid "End must not be before start."
msgstr "لا يمكن أن تسبق النهاية البداية."

#, python-format
msgid "Range must not exceed %(days)s days."
msgstr "يجب ألا تتجاوز المدة %(days)s يومًا."

#, python-format
msgid "End must be on or after start and within %(days)s days."
msgstr "يجب أن تكون النهاية في يوم البداية أو بعده وضمن %(days)s يومًا."

#, python-format
msgid "Give between 1 and %(max)s sources."
msgstr "حدّد من 1 إلى %(max)s دولة."

msgid "Weekdays must not repeat."
msgstr "لا يمكن تكرار أيام الأسبوع."

msgid "No source country supports this language."
msgstr "لا تدعم أي من الدول المضافة هذه اللغة."

msgid "This calendar already has a custom day on this date."
msgstr "يحتوي هذا التقويم بالفعل على يوم خاص في هذا التاريخ."

#, python-format
msgid "A calendar can have at most %(max)s active feed links."
msgstr "يمكن أن يحتوي التقويم على %(max)s من روابط الخلاصات النشطة كحد أقصى."

#, python-format
msgid "Holidays in the next %(days)s days: %(calendar)s"
msgstr "العطلات في الأيام الـ%(days)s القادمة: %(calendar)s"

msgid "Company closure"
msgstr "إغلاق الشركة"

msgid "Half day"
msgstr "نصف يوم"

msgid "Extra working day"
msgstr "يوم عمل إضافي"

msgid "Holiday"
msgstr "عطلة"

#, python-format
msgid "%(name)s: the next %(days)s days"
msgstr "%(name)s: الأيام الـ%(days)s القادمة"

msgid "No holidays or company days off in this period."
msgstr "لا توجد عطلات أو أيام إجازة للشركة في هذه الفترة."

msgid "Open the calendar"
msgstr "افتح التقويم"

msgid ""
"You get this email once a month because you subscribed to this calendar."
msgstr "تصلك هذه الرسالة مرة كل شهر لأنك اشتركت في هذا التقويم."

msgid "Unsubscribe"
msgstr "إلغاء الاشتراك"

msgid "Open the calendar:"
msgstr "افتح التقويم:"

msgid "Unsubscribe:"
msgstr "إلغاء الاشتراك:"

msgid "Only owners can grant the owner role."
msgstr "لا يمكن إلا للمالكين منح دور المالك."

msgid "This person is already a member."
msgstr "هذا الشخص عضو بالفعل."

#, python-format
msgid "An organization can have at most %(max)s pending invites."
msgstr "يمكن أن تحتوي المؤسسة على %(max)s من الدعوات المعلّقة كحد أقصى."

msgid "The invite email could not be sent. Try again."
msgstr "تعذّر إرسال رسالة الدعوة. حاول مرة أخرى."

#, python-format
msgid "This invite is for %(email)s. Log in with that account to accept it."
msgstr "هذه الدعوة موجّهة إلى %(email)s. سجّل الدخول بذلك الحساب لقبولها."

msgid "Owner"
msgstr "مالك"

msgid "Admin"
msgstr "مسؤول"

msgid "Member"
msgstr "عضو"

msgid "Viewer"
msgstr "مُشاهد"

#, python-format
msgid "You're invited to %(org)s on HolidayOps"
msgstr "أنت مدعو للانضمام إلى %(org)s على HolidayOps"

msgid "Your role does not allow this action."
msgstr "دورك لا يسمح بهذا الإجراء."

#, python-format
msgid "%(inviter)s invited you to join %(org)s on HolidayOps as %(role)s."
msgstr "دعاك %(inviter)s للانضمام إلى %(org)s على HolidayOps بصفة %(role)s."

msgid "Accept the invite"
msgstr "قبول الدعوة"

#, python-format
msgid ""
"The link works once and expires in %(days)s days. If you weren't expecting "
"this, you can ignore this email."
msgstr ""
"يعمل الرابط مرة واحدة وتنتهي صلاحيته خلال %(days)s أيام. إذا لم تكن تتوقع "
"هذه الرسالة فيمكنك تجاهلها."

msgid "Accept the invite:"
msgstr "قبول الدعوة:"

msgid "Only owners can grant or remove the owner role."
msgstr "لا يمكن إلا للمالكين منح دور المالك أو إزالته."

msgid "An organization needs at least one owner."
msgstr "يجب أن يكون للمؤسسة مالك واحد على الأقل."

msgid "No account uses this email yet."
msgstr "لا يوجد حساب بهذا البريد الإلكتروني بعد."

msgid "Skip to content"
msgstr "انتقل إلى المحتوى"

msgid "Main"
msgstr "الرئيسية"

msgid "Holidays"
msgstr "العطلات"

msgid "Pricing"
msgstr "الأسعار"

msgid "API docs"
msgstr "توثيق API"

msgid "Log in"
msgstr "تسجيل الدخول"

msgid "Language"
msgstr "اللغة"

msgid ""
"Holiday data from the open-source holidays library. Dates marked “estimated” "
"follow the lunar calendar and can move by a day."
msgstr ""
"بيانات العطلات من مكتبة holidays مفتوحة المصدر. التواريخ الموسومة "
"بـ“estimated” تتبع التقويم القمري وقد تتغير بيوم."

msgid "Pro"
msgstr "احترافية"

msgid "Free"
msgstr "مجانية"

#, python-format
msgid "<span class=\"ltr\">%(rate)s</span> per API key"
msgstr "<span class=\"ltr\">%(rate)s</span> لكل مفتاح API"

#, python-format
msgid "%(quota)s requests a month"
msgstr "%(quota)s طلب شهريًا"

#, python-format
msgid "%(keys)s API key"
msgid_plural "%(keys)s API keys"
msgstr[0] "لا مفاتيح API"
msgstr[1] "مفتاح API واحد"
msgstr[2] "مفتاحا API"
msgstr[3] "%(keys)s مفاتيح API"
msgstr[4] "%(keys)s مفتاحًا API"
msgstr[5] "%(keys)s مفتاح API"

msgid "Company calendars, iCal feeds, digests and webhooks"
msgstr "تقاويم الشركة وخلاصات iCal والملخصات وخطافات الويب"

msgid "Start free"
msgstr "ابدأ مجانًا"

msgid "Contact us to upgrade."
msgstr "تواصل معنا للترقية."

msgid "Read the API docs"
msgstr "اقرأ توثيق API"

msgid "Public holidays"
msgstr "العطلات الرسمية"

msgid "Working days"
msgstr "أيام العمل"

msgid "Weekend"
msgstr "عطلة نهاية الأسبوع"

msgid "Date"
msgstr "التاريخ"

msgid "No public holidays this year."
msgstr "لا توجد عطلات رسمية هذه السنة."

msgid "Other years"
msgstr "سنوات أخرى"

#, python-format
msgid "All of %(country)s"
msgstr "كل %(country)s"

msgid "Regions"
msgstr "المناطق"

msgid "Use these dates in your software"
msgstr "استخدم هذه التواريخ في برامجك"

msgid ""
"Check working days, add business days and merge countries with your own "
"company closures through the HolidayOps API."
msgstr ""
"تحقق من أيام العمل وأضف أيام العمل وادمج الدول مع أيام إغلاق شركتك عبر واجهة "
"HolidayOps."

msgid "Get an API key"
msgstr "احصل على مفتاح API"

msgid "Public holidays by country"
msgstr "العطلات الرسمية حسب الدولة"

#, python-format
msgid ""
"Public holidays and working days for %(count)s countries, with the dates for "
"every year."
msgstr "العطلات الرسمية وأيام العمل لـ%(count)s دولة، مع التواريخ لكل سنة."

#, python-format
msgid "Public holidays in %(place)s %(year)s"
msgstr "العطلات الرسمية في %(place)s لعام %(year)s"

#, python-format
msgid ""
"All %(count)s public holidays in %(place)s in %(year)s, with dates, weekdays "
"and %(working)s working days."
msgstr ""
"جميع العطلات الرسمية الـ%(count)s في %(place)s لعام %(year)s، مع التواريخ "
"وأيام الأسبوع و%(working)s يوم عمل."

msgid "API plans for HolidayOps: requests per minute, per month and API keys."
msgstr "خطط API في HolidayOps: الطلبات في الدقيقة وفي الشهر ومفاتيح API."

msgid "Webhook URLs must use https."
msgstr "يجب أن تستخدم عناوين الخطافات https."

msgid "Webhook URLs must not contain credentials."
msgstr "يجب ألا تحتوي عناوين الخطافات على بيانات اعتماد."

msgid "Webhook URL has no host."
msgstr "عنوان الخطاف لا يحتوي على مضيف."

msgid "Webhook URL has an invalid port."
msgstr "منفذ عنوان الخطاف غير صالح."

msgid "Webhook host does not resolve."
msgstr "تعذّر العثور على مضيف الخطاف."

msgid "Webhook host must resolve to public addresses only."
msgstr "يجب أن يشير مضيف الخطاف إلى عناوين عامة فقط."

#, python-format
msgid "An organization can have at most %(max)s webhooks."
msgstr "يمكن أن تحتوي المؤسسة على %(max)s من الخطافات كحد أقصى."
