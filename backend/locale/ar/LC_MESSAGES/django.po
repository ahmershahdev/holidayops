msgid "An account with this email already exists."
msgstr "يوجد حساب بهذا البريد الإلكتروني بالفعل."

msgid "Invalid email or password."
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة."

msgid "Invalid or revoked API key."
msgstr "مفتاح API غير صالح أو أُلغي."

#, python-format
msgid "Country %(value)s is not supported."
msgstr "الدولة %(value)s غير مدعومة."

#, python-format
msgid "Subdivision %(value)s is not supported for %(country)s."
msgstr "المنطقة %(value)s غير مدعومة في %(country)s."

#, python-format
msgid "Language %(value)s is not supported for %(country)s."
msgstr "اللغة %(value)s غير مدعومة في %(country)s."

#, python-format
msgid "Categories not supported for %(country)s: %(value)s."
msgstr "فئات غير مدعومة في %(country)s: %(value)s."

#, python-format
msgid "Years must be between %(min)s and %(max)s."
msgstr "يجب أن تكون السنوات بين %(min)s و%(max)s."

msgid "Result falls outside the supported year range."
msgstr "النتيجة خارج نطاق السنوات المدعومة."

#, python-format
msgid "Your plan allows at most %(max)s active API keys."
msgstr "تسمح خطتك بـ%(max)s من مفاتيح API النشطة كحد أقصى."

#, python-format
msgid "Year must be between %(min)s and %(max)s."
msgstr "يجب أن تكون السنة بين %(min)s و%(max)s."

msgid "Give exactly one of country or calendar."
msgstr "حدّد إما الدولة أو التقويم، وليس كليهما."

msgid "Not allowed with calendar; the calendar defines it."
msgstr "غير مسموح به مع التقويم؛ فالتقويم يحدده."

msgid "End must not be before start."
msgstr "لا يمكن أن تسبق النهاية البداية."

#, python-format
msgid "Range must not exceed %(days)s days."
msgstr "يجب ألا تتجاوز المدة %(days)s يومًا."

#, python-format
msgid "End must be on or after start and within %(days)s days."
msgstr "يجب أن تكون النهاية في يوم البداية أو بعده وضمن %(days)s يومًا."

#, python-format
msgid "Give between 1 and %(max)s sources."
msgstr "حدّد من 1 إلى %(max)s دولة."

msgid "Weekdays must not repeat."
msgstr "لا يمكن تكرار أيام الأسبوع."

msgid "No source country supports this language."
msgstr "لا تدعم أي من الدول المضافة هذه اللغة."

msgid "This calendar already has a custom day on this date."
msgstr "يحتوي هذا التقويم بالفعل على يوم خاص في هذا التاريخ."

#, python-format
msgid "A calendar can have at most %(max)s active feed links."
msgstr "يمكن أن يحتوي التقويم على %(max)s من روابط الخلاصات النشطة كحد أقصى."

#, python-format
msgid "Holidays in the next %(days)s days: %(calendar)s"
msgstr "العطلات في الأيام الـ%(days)s القادمة: %(calendar)s"

msgid "Company closure"
msgstr "إغلاق الشركة"

msgid "Half day"
msgstr "نصف يوم"

msgid "Extra working day"
msgstr "يوم عمل إضافي"

msgid "Holiday"
msgstr "عطلة"

#, python-format
msgid "%(name)s: the next %(days)s days"
msgstr "%(name)s: الأيام الـ%(days)s القادمة"

msgid "No holidays or company days off in this period."
msgstr "لا توجد عطلات أو أيام إجازة للشركة في هذه الفترة."

msgid "Open the calendar"
msgstr "افتح التقويم"

msgid ""
"You get this email once a month because you subscribed to this calendar."
msgstr "تصلك هذه الرسالة مرة كل شهر لأنك اشتركت في هذا التقويم."

msgid "Unsubscribe"
msgstr "إلغاء الاشتراك"

msgid "Open the calendar:"
msgstr "افتح التقويم:"

msgid "Unsubscribe:"
msgstr "إلغاء الاشتراك:"

msgid "Only owners can grant the owner role."
msgstr "لا يمكن إلا للمالكين منح دور المالك."

msgid "This person is already a member."
msgstr "هذا الشخص عضو بالفعل."

#, python-format
msgid "An organization can have at most %(max)s pending invites."
msgstr "يمكن أن تحتوي المؤسسة على %(max)s من الدعوات المعلّقة كحد أقصى."

msgid "The invite email could not be sent. Try again."
msgstr "تعذّر إرسال رسالة الدعوة. حاول مرة أخرى."

#, python-format
msgid "This invite is for %(email)s. Log in with that account to accept it."
msgstr "هذه الدعوة موجّهة إلى %(email)s. سجّل الدخول بذلك الحساب لقبولها."

msgid "Owner"
msgstr "مالك"

msgid "Admin"
msgstr "مسؤول"

msgid "Member"
msgstr "عضو"

msgid "Viewer"
msgstr "مُشاهد"

#, python-format
msgid "You're invited to %(org)s on HolidayOps"
msgstr "أنت مدعو للانضمام إلى %(org)s على HolidayOps"

msgid "Your role does not allow this action."
msgstr "دورك لا يسمح بهذا الإجراء."

#, python-format
msgid "%(inviter)s invited you to join %(org)s on HolidayOps as %(role)s."
msgstr "دعاك %(inviter)s للانضمام إلى %(org)s على HolidayOps بصفة %(role)s."

msgid "Accept the invite"
msgstr "قبول الدعوة"

#, python-format
msgid ""
"The link works once and expires in %(days)s days. If you weren't expecting "
"this, you can ignore this email."
msgstr ""
"يعمل الرابط مرة واحدة وتنتهي صلاحيته خلال %(days)s أيام. إذا لم تكن تتوقع "
"هذه الرسالة فيمكنك تجاهلها."

msgid "Accept the invite:"
msgstr "قبول الدعوة:"

msgid "Only owners can grant or remove the owner role."
msgstr "لا يمكن إلا للمالكين منح دور المالك أو إزالته."

msgid "An organization needs at least one owner."
msgstr "يجب أن يكون للمؤسسة مالك واحد على الأقل."

msgid "No account uses this email yet."
msgstr "لا يوجد حساب بهذا البريد الإلكتروني بعد."

msgid "a working day"
msgstr "يوم عمل"

msgid "a weekend day"
msgstr "يوم عطلة أسبوعية"

msgid "a public holiday"
msgstr "عطلة رسمية"

msgid "a working weekend day (moved working day)"
msgstr "يوم عمل في عطلة الأسبوع (يوم عمل منقول)"

msgid "Pick a valid date."
msgstr "اختر تاريخًا صحيحًا."

msgid "Pick a country from the list."
msgstr "اختر دولة من القائمة."

msgid "Pick a date within five years of today."
msgstr "اختر تاريخًا في حدود خمس سنوات من اليوم."

msgid "That date can't be checked."
msgstr "لا يمكن التحقق من هذا التاريخ."

msgid "Holidays and working days for every country"
msgstr "العطلات وأيام العمل لكل دولة"

msgid ""
"HolidayOps answers “is it a working day?” for 250 countries and their "
"regions, merged with your own company closures, through a fast API, iCal "
"feeds and webhooks."
msgstr ""
"يجيب HolidayOps عن سؤال ”هل هو يوم عمل؟“ لـ250 دولة ومناطقها، مدمجًا مع أيام "
"إغلاق شركتك، عبر واجهة سريعة وخلاصات iCal وخطافات الويب."

msgid "This flight went off course"
msgstr "هذه الرحلة ضلّت طريقها"

msgid ""
"The page you asked for doesn't exist, or it moved. Pick a destination below."
msgstr "الصفحة التي طلبتها غير موجودة أو نُقلت. اختر وجهة من الأسفل."

msgid "Go home"
msgstr "الصفحة الرئيسية"

msgid "Browse holidays by country"
msgstr "تصفّح العطلات حسب الدولة"

msgid "API docs"
msgstr "توثيق API"

msgid ""
"Holidays and working days for 250 countries, merged with your own company "
"calendar."
msgstr "العطلات وأيام العمل لـ250 دولة، مدمجة مع تقويم شركتك."

msgid "Start free"
msgstr "ابدأ مجانًا"

msgid "Product"
msgstr "المنتج"

msgid "Holidays"
msgstr "العطلات"

msgid "Pricing"
msgstr "الأسعار"

msgid "Playground"
msgstr "ساحة التجربة"

msgid "Company calendars"
msgstr "تقاويم الشركة"

msgid "Popular countries"
msgstr "دول شائعة"

msgid "Developers"
msgstr "المطوّرون"

msgid "OpenAPI schema"
msgstr "مخطط OpenAPI"

msgid "Sitemap"
msgstr "خريطة الموقع"

msgid "Holiday data: the open-source holidays library."
msgstr "بيانات العطلات: مكتبة holidays مفتوحة المصدر."

msgid "Back to top"
msgstr "العودة للأعلى"

msgid "Main"
msgstr "الرئيسية"

msgid "Log in"
msgstr "تسجيل الدخول"

msgid "Menu"
msgstr "القائمة"

msgid "Language"
msgstr "اللغة"

msgid "Theme"
msgstr "المظهر"

msgid "Light"
msgstr "فاتح"

msgid "Match my device"
msgstr "حسب جهازي"

msgid "Dark"
msgstr "داكن"

msgid "Skip to content"
msgstr "انتقل إلى المحتوى"

#, python-format
msgid "%(countries)s countries · 3 languages · one API"
msgstr "%(countries)s دولة · 3 لغات · واجهة واحدة"

msgid "Every working day,"
msgstr "كل يوم عمل،"

msgid "in every country."
msgstr "في كل دولة."

msgid ""
"Public holidays, weekends and your own company closures, merged into one "
"answer: is this a working day? For payroll, HR, logistics and finance teams."
msgstr ""
"العطلات الرسمية وعطلات نهاية الأسبوع وأيام إغلاق شركتك في إجابة واحدة: هل "
"هذا يوم عمل؟ لفرق الرواتب والموارد البشرية والخدمات اللوجستية والمالية."

msgid "Explore holidays"
msgstr "استكشف العطلات"

msgid "countries"
msgstr "دولة"

msgid "regions"
msgstr "منطقة"

msgid "languages, RTL ready"
msgstr "لغات، جاهزة للكتابة من اليمين"

#, python-format
msgid "Public holidays in %(country)s this month"
msgstr "العطلات الرسمية في %(country)s هذا الشهر"

msgid "Weekend"
msgstr "عطلة نهاية الأسبوع"

msgid "Today"
msgstr "اليوم"

msgid "Is it a working day?"
msgstr "هل هو يوم عمل؟"

msgid "Ask the same engine the API uses. No account needed."
msgstr "اسأل المحرك نفسه الذي تستخدمه الواجهة. لا حاجة إلى حساب."

msgid "Country"
msgstr "الدولة"

msgid "Date"
msgstr "التاريخ"

msgid "Check"
msgstr "تحقّق"

msgid "Yes, it's a working day."
msgstr "نعم، إنه يوم عمل."

msgid "No, it's a day off."
msgstr "لا، إنه يوم عطلة."

#, python-format
msgid "%(day)s in %(country)s is %(reason)s."
msgstr "%(day)s في %(country)s هو %(reason)s."

msgid "Everything a calendar of working days needs"
msgstr "كل ما يحتاجه تقويم أيام العمل"

msgid ""
"Merge several countries and regions with your own closures, half days and "
"extra working days. Office in Karachi, team in Riyadh? One calendar."
msgstr ""
"ادمج عدة دول ومناطق مع أيام الإغلاق وأنصاف الأيام وأيام العمل الإضافية "
"الخاصة بك. مكتب في كراتشي وفريق في الرياض؟ تقويم واحد."

msgid "Business-day maths"
msgstr "حساب أيام العمل"

msgid ""
"Add or subtract working days and count them between two dates, with each "
"country's own weekend."
msgstr ""
"أضف أيام العمل أو اطرحها واحسبها بين تاريخين، مع عطلة نهاية الأسبوع الخاصة "
"بكل دولة."

msgid "iCal feeds"
msgstr "خلاصات iCal"

msgid ""
"Subscribe from Google Calendar, Outlook or Apple Calendar with a private, "
"revocable link."
msgstr "اشترك من تقويم Google أو Outlook أو تقويم Apple برابط خاص يمكن إلغاؤه."

msgid "Monthly digests"
msgstr "ملخصات شهرية"

msgid ""
"An email on the 1st with the next 30 days of holidays, in English, Urdu or "
"Arabic."
msgstr ""
"رسالة في أول كل شهر بعطلات الأيام الثلاثين القادمة، بالإنجليزية أو الأردية "
"أو العربية."

msgid "Signed webhooks"
msgstr "خطافات ويب موقّعة"

msgid ""
"HMAC-signed events when calendars change, with retries and a delivery log."
msgstr "أحداث موقّعة بـHMAC عند تغيّر التقاويم، مع إعادة المحاولة وسجل التسليم."

msgid "API keys with plans and quotas"
msgstr "مفاتيح API مع خطط وحصص"

msgid ""
"Per-key rate limits, a monthly quota and a usage chart, so you always know "
"where you stand."
msgstr "حدود معدل لكل مفتاح وحصة شهرية ومخطط استخدام، لتعرف موقفك دائمًا."

msgid "From sign-up to answers in three steps"
msgstr "من التسجيل إلى الإجابات في ثلاث خطوات"

msgid "Pick your countries"
msgstr "اختر دولك"

msgid ""
"Choose countries, regions and holiday categories. Weekends come from each "
"country's own rules."
msgstr ""
"اختر الدول والمناطق وفئات العطلات. عطلات نهاية الأسبوع تأتي من قواعد كل دولة."

msgid "Add your own days"
msgstr "أضف أيامك الخاصة"

msgid "Mark office closures, half days and extra working days on the calendar."
msgstr "حدّد أيام إغلاق المكتب وأنصاف الأيام وأيام العمل الإضافية على التقويم."

msgid "Ask from anywhere"
msgstr "اسأل من أي مكان"

msgid ""
"Call the API with a key, subscribe to the feed, or get a webhook when "
"something changes."
msgstr ""
"استدعِ الواجهة بمفتاح، أو اشترك في الخلاصة، أو استقبل خطاف ويب عند حدوث تغيير."

msgid "One request, one clear answer"
msgstr "طلب واحد، إجابة واضحة"

msgid ""
"JSON over HTTPS, documented with OpenAPI. Holiday names come back in the "
"language you ask for."
msgstr "JSON عبر HTTPS موثّق بـOpenAPI. تعود أسماء العطلات باللغة التي تطلبها."

msgid "Read the API docs"
msgstr "اقرأ توثيق API"

msgid "Holidays for every country, every year"
msgstr "العطلات لكل دولة، كل سنة"

#, python-format
msgid "See all %(countries)s countries →"
msgstr "عرض جميع الدول الـ%(countries)s ←"

msgid "Start free. Upgrade when you grow."
msgstr "ابدأ مجانًا. رقِّ خطتك عندما تكبر."

msgid ""
"The free plan includes company calendars, feeds, digests, webhooks and "
"10,000 API requests a month."
msgstr ""
"تشمل الخطة المجانية تقاويم الشركة والخلاصات والملخصات وخطافات الويب و10,000 "
"طلب API شهريًا."

msgid "See pricing"
msgstr "عرض الأسعار"

msgid "Pro"
msgstr "احترافية"

msgid "Free"
msgstr "مجانية"

#, python-format
msgid "<span class=\"ltr\">%(rate)s</span> per API key"
msgstr "<span class=\"ltr\">%(rate)s</span> لكل مفتاح API"

#, python-format
msgid "%(quota)s requests a month"
msgstr "%(quota)s طلب شهريًا"

#, python-format
msgid "%(keys)s API key"
msgid_plural "%(keys)s API keys"
msgstr[0] "لا مفاتيح API"
msgstr[1] "مفتاح API واحد"
msgstr[2] "مفتاحا API"
msgstr[3] "%(keys)s مفاتيح API"
msgstr[4] "%(keys)s مفتاحًا API"
msgstr[5] "%(keys)s مفتاح API"

msgid "Company calendars, iCal feeds, digests and webhooks"
msgstr "تقاويم الشركة وخلاصات iCal والملخصات وخطافات الويب"

msgid "Contact us to upgrade."
msgstr "تواصل معنا للترقية."

msgid "Public holidays"
msgstr "العطلات الرسمية"

msgid "Working days"
msgstr "أيام العمل"

msgid "No public holidays this year."
msgstr "لا توجد عطلات رسمية هذه السنة."

msgid "Other years"
msgstr "سنوات أخرى"

#, python-format
msgid "All of %(country)s"
msgstr "كل %(country)s"

msgid "Regions"
msgstr "المناطق"

msgid "Use these dates in your software"
msgstr "استخدم هذه التواريخ في برامجك"

msgid ""
"Check working days, add business days and merge countries with your own "
"company closures through the HolidayOps API."
msgstr ""
"تحقق من أيام العمل وأضف أيام العمل وادمج الدول مع أيام إغلاق شركتك عبر واجهة "
"HolidayOps."

msgid "Get an API key"
msgstr "احصل على مفتاح API"

msgid "Public holidays by country"
msgstr "العطلات الرسمية حسب الدولة"

#, python-format
msgid ""
"Public holidays and working days for %(count)s countries, with the dates for "
"every year."
msgstr "العطلات الرسمية وأيام العمل لـ%(count)s دولة، مع التواريخ لكل سنة."

#, python-format
msgid "Public holidays in %(place)s %(year)s"
msgstr "العطلات الرسمية في %(place)s لعام %(year)s"

#, python-format
msgid ""
"All %(count)s public holidays in %(place)s in %(year)s, with dates, weekdays "
"and %(working)s working days."
msgstr ""
"جميع العطلات الرسمية الـ%(count)s في %(place)s لعام %(year)s، مع التواريخ "
"وأيام الأسبوع و%(working)s يوم عمل."

msgid "API plans for HolidayOps: requests per minute, per month and API keys."
msgstr "خطط API في HolidayOps: الطلبات في الدقيقة وفي الشهر ومفاتيح API."

msgid "Webhook URLs must use https."
msgstr "يجب أن تستخدم عناوين الخطافات https."

msgid "Webhook URLs must not contain credentials."
msgstr "يجب ألا تحتوي عناوين الخطافات على بيانات اعتماد."

msgid "Webhook URL has no host."
msgstr "عنوان الخطاف لا يحتوي على مضيف."

msgid "Webhook URL has an invalid port."
msgstr "منفذ عنوان الخطاف غير صالح."

msgid "Webhook host does not resolve."
msgstr "تعذّر العثور على مضيف الخطاف."

msgid "Webhook host must resolve to public addresses only."
msgstr "يجب أن يشير مضيف الخطاف إلى عناوين عامة فقط."

#, python-format
msgid "An organization can have at most %(max)s webhooks."
msgstr "يمكن أن تحتوي المؤسسة على %(max)s من الخطافات كحد أقصى."

msgid "Page not found"
msgstr "الصفحة غير موجودة"

msgid "This page doesn't exist."
msgstr "هذه الصفحة غير موجودة."
