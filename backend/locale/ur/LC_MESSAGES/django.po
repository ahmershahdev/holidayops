msgid "An account with this email already exists."
msgstr "اس ای میل سے پہلے ہی ایک اکاؤنٹ موجود ہے۔"

msgid "Invalid email or password."
msgstr "ای میل یا پاس ورڈ درست نہیں۔"

msgid "Invalid or revoked API key."
msgstr "API کلید غلط ہے یا منسوخ کی جا چکی ہے۔"

#, python-format
msgid "Country %(value)s is not supported."
msgstr "ملک %(value)s دستیاب نہیں ہے۔"

#, python-format
msgid "Subdivision %(value)s is not supported for %(country)s."
msgstr "علاقہ %(value)s، %(country)s کے لیے دستیاب نہیں ہے۔"

#, python-format
msgid "Language %(value)s is not supported for %(country)s."
msgstr "زبان %(value)s، %(country)s کے لیے دستیاب نہیں ہے۔"

#, python-format
msgid "Categories not supported for %(country)s: %(value)s."
msgstr "%(country)s کے لیے یہ اقسام دستیاب نہیں: %(value)s۔"

#, python-format
msgid "Years must be between %(min)s and %(max)s."
msgstr "سال %(min)s اور %(max)s کے درمیان ہونے چاہییں۔"

msgid "Result falls outside the supported year range."
msgstr "نتیجہ معاون سالوں کی حد سے باہر ہے۔"

#, python-format
msgid "Your plan allows at most %(max)s active API keys."
msgstr "آپ کے پلان میں زیادہ سے زیادہ %(max)s فعال API کلیدیں ہو سکتی ہیں۔"

#, python-format
msgid "Year must be between %(min)s and %(max)s."
msgstr "سال %(min)s اور %(max)s کے درمیان ہونا چاہیے۔"

msgid "Give exactly one of country or calendar."
msgstr "ملک یا کیلنڈر میں سے صرف ایک دیں۔"

msgid "Not allowed with calendar; the calendar defines it."
msgstr "کیلنڈر کے ساتھ اس کی اجازت نہیں؛ یہ کیلنڈر خود طے کرتا ہے۔"

msgid "End must not be before start."
msgstr "اختتام آغاز سے پہلے نہیں ہو سکتا۔"

#, python-format
msgid "Range must not exceed %(days)s days."
msgstr "مدت %(days)s دن سے زیادہ نہیں ہو سکتی۔"

#, python-format
msgid "End must be on or after start and within %(days)s days."
msgstr "اختتام آغاز کے دن یا اس کے بعد اور %(days)s دن کے اندر ہونا چاہیے۔"

#, python-format
msgid "Give between 1 and %(max)s sources."
msgstr "1 سے %(max)s تک ممالک دیں۔"

msgid "Weekdays must not repeat."
msgstr "ہفتے کے دن دہرائے نہیں جا سکتے۔"

msgid "No source country supports this language."
msgstr "کوئی بھی شامل ملک یہ زبان استعمال نہیں کرتا۔"

msgid "This calendar already has a custom day on this date."
msgstr "اس تاریخ کو اس کیلنڈر میں پہلے سے ایک کمپنی کا دن موجود ہے۔"

#, python-format
msgid "A calendar can have at most %(max)s active feed links."
msgstr "ایک کیلنڈر کے زیادہ سے زیادہ %(max)s فعال فیڈ لنکس ہو سکتے ہیں۔"

#, python-format
msgid "Holidays in the next %(days)s days: %(calendar)s"
msgstr "اگلے %(days)s دنوں کی تعطیلات: %(calendar)s"

msgid "Company closure"
msgstr "کمپنی بند"

msgid "Half day"
msgstr "آدھا دن"

msgid "Extra working day"
msgstr "اضافی کام کا دن"

msgid "Holiday"
msgstr "تعطیل"

#, python-format
msgid "%(name)s: the next %(days)s days"
msgstr "%(name)s: اگلے %(days)s دن"

msgid "No holidays or company days off in this period."
msgstr "اس مدت میں کوئی تعطیل یا کمپنی کی چھٹی نہیں۔"

msgid "Open the calendar"
msgstr "کیلنڈر کھولیں"

msgid ""
"You get this email once a month because you subscribed to this calendar."
msgstr ""
"آپ کو یہ ای میل مہینے میں ایک بار ملتی ہے کیونکہ آپ نے اس کیلنڈر کو سبسکرائب "
"کیا ہے۔"

msgid "Unsubscribe"
msgstr "سبسکرپشن ختم کریں"

msgid "Open the calendar:"
msgstr "کیلنڈر کھولیں:"

msgid "Unsubscribe:"
msgstr "سبسکرپشن ختم کریں:"

msgid "Only owners can grant the owner role."
msgstr "صرف مالکان ہی مالک کا کردار دے سکتے ہیں۔"

msgid "This person is already a member."
msgstr "یہ شخص پہلے سے رکن ہے۔"

#, python-format
msgid "An organization can have at most %(max)s pending invites."
msgstr "ایک تنظیم کے زیادہ سے زیادہ %(max)s زیرِ التوا دعوت نامے ہو سکتے ہیں۔"

msgid "The invite email could not be sent. Try again."
msgstr "دعوت نامے کی ای میل نہیں بھیجی جا سکی۔ دوبارہ کوشش کریں۔"

#, python-format
msgid "This invite is for %(email)s. Log in with that account to accept it."
msgstr ""
"یہ دعوت نامہ %(email)s کے لیے ہے۔ اسے قبول کرنے کے لیے اسی اکاؤنٹ سے لاگ اِن "
"کریں۔"

msgid "Owner"
msgstr "مالک"

msgid "Admin"
msgstr "منتظم"

msgid "Member"
msgstr "رکن"

msgid "Viewer"
msgstr "ناظر"

#, python-format
msgid "You're invited to %(org)s on HolidayOps"
msgstr "آپ کو HolidayOps پر %(org)s میں شامل ہونے کی دعوت دی گئی ہے"

msgid "Your role does not allow this action."
msgstr "آپ کا کردار اس عمل کی اجازت نہیں دیتا۔"

#, python-format
msgid "%(inviter)s invited you to join %(org)s on HolidayOps as %(role)s."
msgstr ""
"%(inviter)s نے آپ کو HolidayOps پر %(org)s میں بطور %(role)s شامل ہونے کی "
"دعوت دی ہے۔"

msgid "Accept the invite"
msgstr "دعوت قبول کریں"

#, python-format
msgid ""
"The link works once and expires in %(days)s days. If you weren't expecting "
"this, you can ignore this email."
msgstr ""
"یہ لنک صرف ایک بار کام کرتا ہے اور %(days)s دن میں ختم ہو جائے گا۔ اگر آپ اس "
"کی توقع نہیں کر رہے تھے تو اس ای میل کو نظرانداز کر دیں۔"

msgid "Accept the invite:"
msgstr "دعوت قبول کریں:"

msgid "Only owners can grant or remove the owner role."
msgstr "صرف مالکان ہی مالک کا کردار دے یا ہٹا سکتے ہیں۔"

msgid "An organization needs at least one owner."
msgstr "تنظیم کا کم از کم ایک مالک ہونا ضروری ہے۔"

msgid "No account uses this email yet."
msgstr "اس ای میل سے ابھی کوئی اکاؤنٹ نہیں ہے۔"

msgid "a working day"
msgstr "کام کا دن"

msgid "a weekend day"
msgstr "ہفتہ وار چھٹی کا دن"

msgid "a public holiday"
msgstr "عام تعطیل"

msgid "a working weekend day (moved working day)"
msgstr "ہفتہ وار چھٹی کے دن کام (منتقل شدہ کام کا دن)"

msgid "Pick a valid date."
msgstr "درست تاریخ چنیں۔"

msgid "Pick a country from the list."
msgstr "فہرست سے ملک چنیں۔"

msgid "Pick a date within five years of today."
msgstr "آج سے پانچ سال کے اندر کی تاریخ چنیں۔"

msgid "That date can't be checked."
msgstr "اس تاریخ کی جانچ نہیں ہو سکتی۔"

msgid "Holidays and working days for every country"
msgstr "ہر ملک کی تعطیلات اور کام کے دن"

msgid ""
"HolidayOps answers “is it a working day?” for 250 countries and their "
"regions, merged with your own company closures, through a fast API, iCal "
"feeds and webhooks."
msgstr ""
"HolidayOps تیز API، iCal فیڈز اور ویب ہُکس کے ذریعے 250 ممالک اور ان کے "
"علاقوں کے لیے، آپ کی کمپنی کی چھٹیوں سمیت، بتاتا ہے کہ ”کیا آج کام کا دن ہے؟“"

msgid "This flight went off course"
msgstr "یہ پرواز راستہ بھٹک گئی"

msgid ""
"The page you asked for doesn't exist, or it moved. Pick a destination below."
msgstr ""
"آپ کا مطلوبہ صفحہ موجود نہیں یا منتقل ہو گیا ہے۔ نیچے سے کوئی منزل چنیں۔"

msgid "Go home"
msgstr "ہوم پر جائیں"

msgid "Browse holidays by country"
msgstr "ملک کے لحاظ سے تعطیلات دیکھیں"

msgid "API docs"
msgstr "API دستاویزات"

msgid ""
"Holidays and working days for 250 countries, merged with your own company "
"calendar."
msgstr ""
"250 ممالک کی تعطیلات اور کام کے دن، آپ کے اپنے کمپنی کیلنڈر کے ساتھ ملا کر۔"

msgid "Start free"
msgstr "مفت شروع کریں"

msgid "Product"
msgstr "پروڈکٹ"

msgid "Holidays"
msgstr "تعطیلات"

msgid "Pricing"
msgstr "قیمتیں"

msgid "Playground"
msgstr "پلے گراؤنڈ"

msgid "Company calendars"
msgstr "کمپنی کیلنڈر"

msgid "Popular countries"
msgstr "مقبول ممالک"

msgid "Developers"
msgstr "ڈویلپرز"

msgid "OpenAPI schema"
msgstr "OpenAPI اسکیما"

msgid "Sitemap"
msgstr "سائٹ میپ"

msgid "Holiday data: the open-source holidays library."
msgstr "تعطیلات کا ڈیٹا: اوپن سورس holidays لائبریری۔"

msgid "Back to top"
msgstr "اوپر جائیں"

msgid "Main"
msgstr "مرکزی"

msgid "Log in"
msgstr "لاگ اِن"

msgid "Menu"
msgstr "مینو"

msgid "Language"
msgstr "زبان"

msgid "Theme"
msgstr "تھیم"

msgid "Light"
msgstr "روشن"

msgid "Match my device"
msgstr "ڈیوائس کے مطابق"

msgid "Dark"
msgstr "تاریک"

msgid "Skip to content"
msgstr "مواد پر جائیں"

#, python-format
msgid "%(countries)s countries · 3 languages · one API"
msgstr "%(countries)s ممالک · 3 زبانیں · ایک API"

msgid "Every working day,"
msgstr "ہر کام کا دن،"

msgid "in every country."
msgstr "ہر ملک میں۔"

msgid ""
"Public holidays, weekends and your own company closures, merged into one "
"answer: is this a working day? For payroll, HR, logistics and finance teams."
msgstr ""
"عام تعطیلات، ہفتہ وار چھٹیاں اور آپ کی کمپنی کی بندشیں، ایک جواب میں: کیا یہ "
"کام کا دن ہے؟ پے رول، ایچ آر، لاجسٹکس اور فنانس ٹیموں کے لیے۔"

msgid "Explore holidays"
msgstr "تعطیلات دیکھیں"

msgid "countries"
msgstr "ممالک"

msgid "regions"
msgstr "علاقے"

msgid "languages, RTL ready"
msgstr "زبانیں، دائیں سے بائیں کے لیے تیار"

#, python-format
msgid "Public holidays in %(country)s this month"
msgstr "اس مہینے %(country)s کی عام تعطیلات"

msgid "Weekend"
msgstr "ہفتہ وار چھٹی"

msgid "Today"
msgstr "آج"

msgid "Is it a working day?"
msgstr "کیا یہ کام کا دن ہے؟"

msgid "Ask the same engine the API uses. No account needed."
msgstr "وہی انجن آزمائیں جو API استعمال کرتا ہے۔ اکاؤنٹ کی ضرورت نہیں۔"

msgid "Country"
msgstr "ملک"

msgid "Date"
msgstr "تاریخ"

msgid "Check"
msgstr "جانچیں"

msgid "Yes, it's a working day."
msgstr "جی ہاں، یہ کام کا دن ہے۔"

msgid "No, it's a day off."
msgstr "نہیں، یہ چھٹی کا دن ہے۔"

#, python-format
msgid "%(day)s in %(country)s is %(reason)s."
msgstr "%(country)s میں %(day)s %(reason)s ہے۔"

msgid "Everything a calendar of working days needs"
msgstr "کام کے دنوں کے کیلنڈر کو جو کچھ چاہیے"

msgid ""
"Merge several countries and regions with your own closures, half days and "
"extra working days. Office in Karachi, team in Riyadh? One calendar."
msgstr ""
"کئی ممالک اور علاقوں کو اپنی بندشوں، آدھے دنوں اور اضافی کام کے دنوں کے ساتھ "
"ملائیں۔ دفتر کراچی میں، ٹیم ریاض میں؟ ایک ہی کیلنڈر۔"

msgid "Business-day maths"
msgstr "کاروباری دنوں کا حساب"

msgid ""
"Add or subtract working days and count them between two dates, with each "
"country's own weekend."
msgstr ""
"ہر ملک کی اپنی ہفتہ وار چھٹی کے ساتھ کام کے دن جمع یا تفریق کریں اور دو "
"تاریخوں کے درمیان گنیں۔"

msgid "iCal feeds"
msgstr "iCal فیڈز"

msgid ""
"Subscribe from Google Calendar, Outlook or Apple Calendar with a private, "
"revocable link."
msgstr ""
"نجی اور منسوخ کیے جا سکنے والے لنک کے ذریعے گوگل کیلنڈر، آؤٹ لک یا ایپل "
"کیلنڈر میں سبسکرائب کریں۔"

msgid "Monthly digests"
msgstr "ماہانہ خلاصے"

msgid ""
"An email on the 1st with the next 30 days of holidays, in English, Urdu or "
"Arabic."
msgstr ""
"ہر ماہ کی پہلی تاریخ کو اگلے 30 دنوں کی تعطیلات کی ای میل، انگریزی، اردو یا "
"عربی میں۔"

msgid "Signed webhooks"
msgstr "دستخط شدہ ویب ہُکس"

msgid ""
"HMAC-signed events when calendars change, with retries and a delivery log."
msgstr ""
"کیلنڈر بدلنے پر HMAC دستخط شدہ ایونٹس، دوبارہ کوشش اور ترسیل کے ریکارڈ کے "
"ساتھ۔"

msgid "API keys with plans and quotas"
msgstr "پلان اور حدود کے ساتھ API کلیدیں"

msgid ""
"Per-key rate limits, a monthly quota and a usage chart, so you always know "
"where you stand."
msgstr ""
"ہر کلید کی شرح کی حد، ماہانہ کوٹا اور استعمال کا چارٹ، تاکہ آپ ہمیشہ اپنی "
"صورتحال جانیں۔"

msgid "From sign-up to answers in three steps"
msgstr "سائن اپ سے جواب تک تین مراحل میں"

msgid "Pick your countries"
msgstr "اپنے ممالک چنیں"

msgid ""
"Choose countries, regions and holiday categories. Weekends come from each "
"country's own rules."
msgstr ""
"ممالک، علاقے اور تعطیلات کی اقسام چنیں۔ ہفتہ وار چھٹیاں ہر ملک کے اپنے "
"اصولوں سے آتی ہیں۔"

msgid "Add your own days"
msgstr "اپنے دن شامل کریں"

msgid "Mark office closures, half days and extra working days on the calendar."
msgstr "کیلنڈر پر دفتر کی بندش، آدھے دن اور اضافی کام کے دن لگائیں۔"

msgid "Ask from anywhere"
msgstr "کہیں سے بھی پوچھیں"

msgid ""
"Call the API with a key, subscribe to the feed, or get a webhook when "
"something changes."
msgstr ""
"کلید کے ساتھ API بلائیں، فیڈ سبسکرائب کریں، یا کچھ بدلنے پر ویب ہُک پائیں۔"

msgid "One request, one clear answer"
msgstr "ایک درخواست، ایک واضح جواب"

msgid ""
"JSON over HTTPS, documented with OpenAPI. Holiday names come back in the "
"language you ask for."
msgstr ""
"HTTPS پر JSON، OpenAPI کے ساتھ دستاویزی۔ تعطیلات کے نام آپ کی مطلوبہ زبان "
"میں آتے ہیں۔"

msgid "Read the API docs"
msgstr "API دستاویزات پڑھیں"

msgid "Holidays for every country, every year"
msgstr "ہر ملک کی، ہر سال کی تعطیلات"

#, python-format
msgid "See all %(countries)s countries →"
msgstr "تمام %(countries)s ممالک دیکھیں ←"

msgid "Start free. Upgrade when you grow."
msgstr "مفت شروع کریں۔ بڑھنے پر اپ گریڈ کریں۔"

msgid ""
"The free plan includes company calendars, feeds, digests, webhooks and "
"10,000 API requests a month."
msgstr ""
"مفت پلان میں کمپنی کیلنڈر، فیڈز، خلاصے، ویب ہُکس اور ماہانہ 10,000 API "
"درخواستیں شامل ہیں۔"

msgid "See pricing"
msgstr "قیمتیں دیکھیں"

msgid "Pro"
msgstr "پرو"

msgid "Free"
msgstr "مفت"

#, python-format
msgid "<span class=\"ltr\">%(rate)s</span> per API key"
msgstr "ہر API کلید کے لیے <span class=\"ltr\">%(rate)s</span>"

#, python-format
msgid "%(quota)s requests a month"
msgstr "ماہانہ %(quota)s درخواستیں"

#, python-format
msgid "%(keys)s API key"
msgid_plural "%(keys)s API keys"
msgstr[0] "%(keys)s API کلید"
msgstr[1] "%(keys)s API کلیدیں"

msgid "Company calendars, iCal feeds, digests and webhooks"
msgstr "کمپنی کیلنڈر، iCal فیڈز، ڈائجسٹ اور ویب ہُکس"

msgid "Contact us to upgrade."
msgstr "اپ گریڈ کے لیے ہم سے رابطہ کریں۔"

msgid "Public holidays"
msgstr "عام تعطیلات"

msgid "Working days"
msgstr "کام کے دن"

msgid "No public holidays this year."
msgstr "اس سال کوئی عام تعطیل نہیں۔"

msgid "Other years"
msgstr "دوسرے سال"

#, python-format
msgid "All of %(country)s"
msgstr "پورا %(country)s"

msgid "Regions"
msgstr "علاقے"

msgid "Use these dates in your software"
msgstr "یہ تاریخیں اپنے سافٹ ویئر میں استعمال کریں"

msgid ""
"Check working days, add business days and merge countries with your own "
"company closures through the HolidayOps API."
msgstr ""
"HolidayOps API کے ذریعے کام کے دن جانچیں، کاروباری دن جمع کریں اور ممالک کو "
"اپنی کمپنی کی چھٹیوں کے ساتھ ملائیں۔"

msgid "Get an API key"
msgstr "API کلید حاصل کریں"

msgid "Public holidays by country"
msgstr "ملک کے لحاظ سے عام تعطیلات"

#, python-format
msgid ""
"Public holidays and working days for %(count)s countries, with the dates for "
"every year."
msgstr ""
"%(count)s ممالک کی عام تعطیلات اور کام کے دن، ہر سال کی تاریخوں کے ساتھ۔"

#, python-format
msgid "Public holidays in %(place)s %(year)s"
msgstr "%(place)s میں %(year)s کی عام تعطیلات"

#, python-format
msgid ""
"All %(count)s public holidays in %(place)s in %(year)s, with dates, weekdays "
"and %(working)s working days."
msgstr ""
"%(place)s میں %(year)s کی تمام %(count)s عام تعطیلات، تاریخوں، دنوں اور "
"%(working)s کام کے دنوں کے ساتھ۔"

msgid "API plans for HolidayOps: requests per minute, per month and API keys."
msgstr "HolidayOps کے API پلان: فی منٹ اور ماہانہ درخواستیں اور API کلیدیں۔"

msgid "Webhook URLs must use https."
msgstr "ویب ہُک URL میں https ہونا لازمی ہے۔"

msgid "Webhook URLs must not contain credentials."
msgstr "ویب ہُک URL میں لاگ اِن کی معلومات نہیں ہونی چاہئیں۔"

msgid "Webhook URL has no host."
msgstr "ویب ہُک URL میں ہوسٹ موجود نہیں۔"

msgid "Webhook URL has an invalid port."
msgstr "ویب ہُک URL کا پورٹ درست نہیں۔"

msgid "Webhook host does not resolve."
msgstr "ویب ہُک ہوسٹ کا پتہ نہیں مل سکا۔"

msgid "Webhook host must resolve to public addresses only."
msgstr "ویب ہُک ہوسٹ کو صرف عوامی پتوں پر ہونا چاہیے۔"

#, python-format
msgid "An organization can have at most %(max)s webhooks."
msgstr "ایک تنظیم کے زیادہ سے زیادہ %(max)s ویب ہُکس ہو سکتے ہیں۔"

msgid "Page not found"
msgstr "صفحہ نہیں ملا"

msgid "This page doesn't exist."
msgstr "یہ صفحہ موجود نہیں ہے۔"
