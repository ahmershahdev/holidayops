# HolidayOps Urdu translations.
#
msgid ""
msgstr ""
"Project-Id-Version: HolidayOps\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-10-23 20:17+0000\n"
"PO-Revision-Date: 2026-10-16 22:30+0500\n"
"Last-Translator: HolidayOps maintainers\n"
"Language-Team: Urdu\n"
"Language: ur\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Confirm your email address first."
msgstr "پہلے اپنا ای میل پتہ کنفرم کریں۔"

msgid "Your HolidayOps password reset code"
msgstr "آپ کا HolidayOps پاس ورڈ ری سیٹ کوڈ"

msgid "Confirm your HolidayOps email"
msgstr "اپنی HolidayOps ای میل کنفرم کریں"

msgid "Your HolidayOps password was changed"
msgstr "آپ کا HolidayOps پاس ورڈ بدل دیا گیا"

msgid "Someone tried to sign up with your email"
msgstr "کسی نے آپ کی ای میل سے سائن اپ کرنے کی کوشش کی"

#
msgid "Welcome to HolidayOps"
msgstr "HolidayOps میں خوش آمدید"

msgid "Security alert for your HolidayOps account"
msgstr "آپ کے HolidayOps اکاؤنٹ کے لیے سیکیورٹی الرٹ"

msgid "Two-factor sign-in was turned on."
msgstr "دو مرحلہ سائن اِن آن کر دیا گیا۔"

msgid "Two-factor sign-in was turned off."
msgstr "دو مرحلہ سائن اِن بند کر دیا گیا۔"

msgid "New recovery codes were made; the old ones no longer work."
msgstr "نئے ریکوری کوڈ بنائے گئے؛ پرانے اب کام نہیں کرتے۔"

msgid "A Google or Microsoft account was linked for sign-in."
msgstr "سائن اِن کے لیے ایک Google یا Microsoft اکاؤنٹ جوڑا گیا۔"

msgid "A Google or Microsoft sign-in was removed."
msgstr "ایک Google یا Microsoft سائن اِن ہٹا دیا گیا۔"

msgid "Your account and its data were deleted."
msgstr "آپ کا اکاؤنٹ اور اس کا ڈیٹا حذف کر دیا گیا۔"

msgid "You already have an account"
msgstr "آپ کا اکاؤنٹ پہلے سے موجود ہے"

msgid ""
"Someone just tried to sign up for HolidayOps with this email address. Your "
"account is unchanged."
msgstr ""
"ابھی کسی نے اس ای میل پتے سے HolidayOps پر سائن اپ کرنے کی کوشش کی۔ آپ کا "
"اکاؤنٹ ویسا ہی ہے۔"

msgid "Log in"
msgstr "لاگ اِن"

#, python-format
msgid ""
"Forgot your password? Use \"Forgot password\" on the login page. If this "
"wasn't you, you don't need to do anything; write to %(support)s if it keeps "
"happening."
msgstr ""
"پاس ورڈ بھول گئے؟ لاگ اِن صفحے پر \"پاس ورڈ بھول گئے\" استعمال کریں۔ اگر یہ "
"آپ نہیں تھے تو کچھ کرنے کی ضرورت نہیں؛ اگر یہ بار بار ہو تو %(support)s پر "
"لکھیں۔"

msgid "A change to your account"
msgstr "آپ کے اکاؤنٹ میں ایک تبدیلی"

#, python-format
msgid ""
"If this was you, there is nothing to do. If it wasn't, reset your password "
"now and write to %(support)s."
msgstr ""
"اگر یہ آپ تھے تو کچھ کرنے کی ضرورت نہیں۔ اگر نہیں، تو ابھی اپنا پاس ورڈ ری "
"سیٹ کریں اور %(support)s پر لکھیں۔"

msgid "Your password was changed"
msgstr "آپ کا پاس ورڈ بدل دیا گیا"

msgid ""
"The password for your HolidayOps account was just changed, and every other "
"session was signed out."
msgstr ""
"آپ کے HolidayOps اکاؤنٹ کا پاس ورڈ ابھی بدلا گیا ہے، اور باقی تمام سیشن سائن "
"آؤٹ کر دیے گئے ہیں۔"

#, python-format
msgid "If this wasn't you, reset your password now and write to %(support)s."
msgstr ""
"اگر یہ آپ نے نہیں کیا تو ابھی اپنا پاس ورڈ ری سیٹ کریں اور %(support)s پر "
"لکھیں۔"

msgid "Reset your password"
msgstr "اپنا پاس ورڈ ری سیٹ کریں"

msgid "Enter this code on the reset page to choose a new password."
msgstr "نیا پاس ورڈ چننے کے لیے یہ کوڈ ری سیٹ والے صفحے پر درج کریں۔"

#, python-format
msgid ""
"The code works once and expires in %(minutes)s minutes. If you didn't ask "
"for it, ignore this email: your password stays the same."
msgstr ""
"یہ کوڈ ایک بار کام کرتا ہے اور %(minutes)s منٹ میں ختم ہو جاتا ہے۔ اگر آپ نے "
"یہ نہیں مانگا تو اس ای میل کو نظرانداز کریں: آپ کا پاس ورڈ وہی رہے گا۔"

msgid "Confirm your email"
msgstr "اپنی ای میل کنفرم کریں"

msgid ""
"Enter this code on the sign-up page to finish creating your HolidayOps "
"account."
msgstr ""
"اپنا HolidayOps اکاؤنٹ مکمل کرنے کے لیے یہ کوڈ سائن اپ صفحے پر درج کریں۔"

#, python-format
msgid ""
"The code works once and expires in %(minutes)s minutes. If you didn't sign "
"up, ignore this email: no account is made without the code."
msgstr ""
"کوڈ ایک بار کام کرتا ہے اور %(minutes)s منٹ میں ختم ہو جاتا ہے۔ اگر آپ نے "
"سائن اپ نہیں کیا تو یہ ای میل نظر انداز کریں: کوڈ کے بغیر کوئی اکاؤنٹ نہیں "
"بنتا۔"

msgid "Your email is confirmed"
msgstr "آپ کی ای میل کنفرم ہو گئی"

msgid ""
"Welcome to HolidayOps. Three steps get you going: create an organization, "
"add a calendar for your country, then mark your own closures on it."
msgstr ""
"HolidayOps میں خوش آمدید۔ تین قدم کافی ہیں: ایک تنظیم بنائیں، اپنے ملک کا "
"کیلنڈر شامل کریں، پھر اس پر اپنی چھٹیاں لگائیں۔"

#
msgid "Open HolidayOps"
msgstr "HolidayOps کھولیں"

#, python-format
msgid ""
"New here? The guide walks through every step: %(app_url)s/guide/. Questions: "
"%(support)s."
msgstr ""
"نئے ہیں؟ رہنمائی ہر قدم سمجھاتی ہے: %(app_url)s/guide/۔ سوالات: %(support)s۔"

msgid "Check your email: if the address can be used, we sent it a code."
msgstr ""
"اپنی ای میل دیکھیں: اگر یہ پتہ استعمال ہو سکتا ہے تو ہم نے اس پر کوڈ بھیج "
"دیا ہے۔"

msgid "Tick the box to show you're not a robot, then try again."
msgstr ""
"یہ دکھانے کے لیے خانے پر نشان لگائیں کہ آپ روبوٹ نہیں ہیں، پھر دوبارہ کوشش "
"کریں۔"

msgid "We couldn't check that you're a person. Try again in a minute."
msgstr "ہم جانچ نہیں سکے کہ آپ انسان ہیں۔ ایک منٹ بعد دوبارہ کوشش کریں۔"

msgid "That code is wrong or has expired. Ask for a new one."
msgstr "یہ کوڈ غلط ہے یا ختم ہو چکا ہے۔ نیا کوڈ منگوائیں۔"

msgid ""
"Too many attempts for this account. Wait 15 minutes, or reset the password."
msgstr ""
"اس اکاؤنٹ پر بہت زیادہ کوششیں ہو چکی ہیں۔ 15 منٹ انتظار کریں یا پاس ورڈ ری "
"سیٹ کریں۔"

msgid "Invalid email or password."
msgstr "ای میل یا پاس ورڈ درست نہیں۔"

#
msgid "If an account uses this email, we sent it a code."
msgstr "اگر اس ای میل سے کوئی اکاؤنٹ ہے تو ہم نے اسے کوڈ بھیج دیا ہے۔"

msgid "That code didn't work. Check your app's clock, or log in again."
msgstr "یہ کوڈ کام نہیں کیا۔ اپنی ایپ کا وقت چیک کریں یا دوبارہ لاگ اِن کریں۔"

msgid "Two-factor sign-in is already on."
msgstr "دو مرحلہ لاگ اِن پہلے سے فعال ہے۔"

#
msgid "That code didn't match. Wait for a new one and try again."
msgstr "کوڈ مطابقت نہیں رکھتا۔ نئے کوڈ کا انتظار کریں اور دوبارہ کوشش کریں۔"

msgid "The password or the code is wrong."
msgstr "پاس ورڈ یا کوڈ غلط ہے۔"

msgid "Set a password first, or this account would have no way to log in."
msgstr ""
"پہلے پاس ورڈ بنائیں، ورنہ اس اکاؤنٹ میں لاگ اِن کا کوئی راستہ نہیں رہے گا۔"

msgid "Type your email address exactly to confirm."
msgstr "تصدیق کے لیے اپنا ای میل پتہ بالکل درست لکھیں۔"

#
msgid "That password is wrong."
msgstr "یہ پاس ورڈ غلط ہے۔"

#, python-format
msgid ""
"Make someone else an owner of %(orgs)s first: they would be left without one."
msgstr ""
"پہلے کسی اور کو %(orgs)s کا مالک بنائیں، ورنہ ان کا کوئی مالک نہیں رہے گا۔"

msgid "Invalid or revoked API key."
msgstr "API کلید غلط ہے یا منسوخ کی جا چکی ہے۔"

#, python-format
msgid "Country %(value)s is not supported."
msgstr "ملک %(value)s دستیاب نہیں ہے۔"

#, python-format
msgid "Subdivision %(value)s is not supported for %(country)s."
msgstr "علاقہ %(value)s، %(country)s کے لیے دستیاب نہیں ہے۔"

#, python-format
msgid "Language %(value)s is not supported for %(country)s."
msgstr "زبان %(value)s، %(country)s کے لیے دستیاب نہیں ہے۔"

#, python-format
msgid "Categories not supported for %(country)s: %(value)s."
msgstr "%(country)s کے لیے یہ اقسام دستیاب نہیں: %(value)s۔"

#, python-format
msgid "Years must be between %(min)s and %(max)s."
msgstr "سال %(min)s اور %(max)s کے درمیان ہونے چاہییں۔"

msgid "Result falls outside the supported year range."
msgstr "نتیجہ معاون سالوں کی حد سے باہر ہے۔"

#, python-format
msgid "Your plan allows at most %(max)s active API keys."
msgstr "آپ کے پلان میں زیادہ سے زیادہ %(max)s فعال API کلیدیں ہو سکتی ہیں۔"

#, python-format
msgid "Year must be between %(min)s and %(max)s."
msgstr "سال %(min)s اور %(max)s کے درمیان ہونا چاہیے۔"

msgid "Give exactly one of country or calendar."
msgstr "ملک یا کیلنڈر میں سے صرف ایک دیں۔"

msgid "Not allowed with calendar; the calendar defines it."
msgstr "کیلنڈر کے ساتھ اس کی اجازت نہیں؛ یہ کیلنڈر خود طے کرتا ہے۔"

msgid "End must not be before start."
msgstr "اختتام آغاز سے پہلے نہیں ہو سکتا۔"

#, python-format
msgid "Range must not exceed %(days)s days."
msgstr "مدت %(days)s دن سے زیادہ نہیں ہو سکتی۔"

#, python-format
msgid "End must be on or after start and within %(days)s days."
msgstr "اختتام آغاز کے دن یا اس کے بعد اور %(days)s دن کے اندر ہونا چاہیے۔"

#, python-format
msgid "Give between 1 and %(max)s sources."
msgstr "1 سے %(max)s تک ممالک دیں۔"

msgid "Weekdays must not repeat."
msgstr "ہفتے کے دن دہرائے نہیں جا سکتے۔"

msgid "No source country supports this language."
msgstr "کوئی بھی شامل ملک یہ زبان استعمال نہیں کرتا۔"

msgid "This calendar already has a custom day on this date."
msgstr "اس تاریخ کو اس کیلنڈر میں پہلے سے ایک کمپنی کا دن موجود ہے۔"

#, python-format
msgid "A calendar can have at most %(max)s active feed links."
msgstr "ایک کیلنڈر کے زیادہ سے زیادہ %(max)s فعال فیڈ لنکس ہو سکتے ہیں۔"

#, python-format
msgid "Holidays in the next %(days)s days: %(calendar)s"
msgstr "اگلے %(days)s دنوں کی تعطیلات: %(calendar)s"

msgid "Company closure"
msgstr "کمپنی بند"

msgid "Half day"
msgstr "آدھا دن"

msgid "Extra working day"
msgstr "اضافی کام کا دن"

msgid "Holiday"
msgstr "تعطیل"

#, python-format
msgid "%(name)s: the next %(days)s days"
msgstr "%(name)s: اگلے %(days)s دن"

msgid "No holidays or company days off in this period."
msgstr "اس مدت میں کوئی تعطیل یا کمپنی کی چھٹی نہیں۔"

msgid "Open the calendar"
msgstr "کیلنڈر کھولیں"

msgid ""
"You get this email once a month because you subscribed to this calendar."
msgstr ""
"آپ کو یہ ای میل مہینے میں ایک بار ملتی ہے کیونکہ آپ نے اس کیلنڈر کو سبسکرائب "
"کیا ہے۔"

msgid "Unsubscribe"
msgstr "سبسکرپشن ختم کریں"

msgid "Open the calendar:"
msgstr "کیلنڈر کھولیں:"

msgid "Unsubscribe:"
msgstr "سبسکرپشن ختم کریں:"

msgid "Only owners can grant the owner role."
msgstr "صرف مالکان ہی مالک کا کردار دے سکتے ہیں۔"

msgid "This person is already a member."
msgstr "یہ شخص پہلے سے رکن ہے۔"

#, python-format
msgid "An organization can have at most %(max)s pending invites."
msgstr "ایک تنظیم کے زیادہ سے زیادہ %(max)s زیرِ التوا دعوت نامے ہو سکتے ہیں۔"

msgid "The invite email could not be sent. Try again."
msgstr "دعوت نامے کی ای میل نہیں بھیجی جا سکی۔ دوبارہ کوشش کریں۔"

#, python-format
msgid "This invite is for %(email)s. Log in with that account to accept it."
msgstr ""
"یہ دعوت نامہ %(email)s کے لیے ہے۔ اسے قبول کرنے کے لیے اسی اکاؤنٹ سے لاگ اِن "
"کریں۔"

msgid "Owner"
msgstr "مالک"

msgid "Admin"
msgstr "منتظم"

msgid "Member"
msgstr "رکن"

msgid "Viewer"
msgstr "ناظر"

#, python-format
msgid "You're invited to %(org)s on HolidayOps"
msgstr "آپ کو HolidayOps پر %(org)s میں شامل ہونے کی دعوت دی گئی ہے"

msgid "Another change is in progress. Try again."
msgstr "ایک اور تبدیلی جاری ہے۔ دوبارہ کوشش کریں۔"

msgid "Your role does not allow this action."
msgstr "آپ کا کردار اس عمل کی اجازت نہیں دیتا۔"

#, python-format
msgid "%(inviter)s invited you to join %(org)s on HolidayOps as %(role)s."
msgstr ""
"%(inviter)s نے آپ کو HolidayOps پر %(org)s میں بطور %(role)s شامل ہونے کی "
"دعوت دی ہے۔"

msgid "Accept the invite"
msgstr "دعوت قبول کریں"

#, python-format
msgid ""
"The link works once and expires in %(days)s days. If you weren't expecting "
"this, you can ignore this email."
msgstr ""
"یہ لنک صرف ایک بار کام کرتا ہے اور %(days)s دن میں ختم ہو جائے گا۔ اگر آپ اس "
"کی توقع نہیں کر رہے تھے تو اس ای میل کو نظرانداز کر دیں۔"

msgid "Accept the invite:"
msgstr "دعوت قبول کریں:"

msgid "Only owners can grant or remove the owner role."
msgstr "صرف مالکان ہی مالک کا کردار دے یا ہٹا سکتے ہیں۔"

msgid "An organization needs at least one owner."
msgstr "تنظیم کا کم از کم ایک مالک ہونا ضروری ہے۔"

msgid "No account uses this email yet."
msgstr "اس ای میل سے ابھی کوئی اکاؤنٹ نہیں ہے۔"

msgid "a working day"
msgstr "کام کا دن"

msgid "a weekend day"
msgstr "ہفتہ وار چھٹی کا دن"

msgid "a public holiday"
msgstr "عام تعطیل"

msgid "a working weekend day (moved working day)"
msgstr "ہفتہ وار چھٹی کے دن کام (منتقل شدہ کام کا دن)"

msgid "Pick a valid date."
msgstr "درست تاریخ چنیں۔"

msgid "Pick a country from the list."
msgstr "فہرست سے ملک چنیں۔"

msgid "Pick a date within five years of today."
msgstr "آج سے پانچ سال کے اندر کی تاریخ چنیں۔"

msgid "That date can't be checked."
msgstr "اس تاریخ کی جانچ نہیں ہو سکتی۔"

msgid "Where does the holiday data come from?"
msgstr "تعطیلات کا ڈیٹا کہاں سے آتا ہے؟"

#
msgid ""
"From holidays, an open-source Python library kept up to date by a large "
"community. HolidayOps adds each country's weekend, moved working days and "
"your own closures on top."
msgstr ""
"holidays سے، جو ایک اوپن سورس Python لائبریری ہے اور جسے ایک بڑی کمیونٹی "
"تازہ رکھتی ہے۔ HolidayOps اس پر ہر ملک کی ہفتہ وار چھٹی، منتقل شدہ کام کے دن "
"اور آپ کی اپنی بندشیں شامل کرتا ہے۔"

msgid "Does it know that weekends differ between countries?"
msgstr "کیا اسے معلوم ہے کہ ہفتہ وار چھٹی ہر ملک میں مختلف ہوتی ہے؟"

msgid ""
"Yes. Saudi Arabia rests on Friday and Saturday, Iran on Friday, Brunei on "
"Friday and Sunday. Every answer uses the country's own weekend, including "
"the years before a country changed it."
msgstr ""
"جی ہاں۔ سعودی عرب میں جمعہ اور ہفتہ کو چھٹی ہوتی ہے، ایران میں جمعہ کو، "
"برونائی میں جمعہ اور اتوار کو۔ ہر جواب اسی ملک کی ہفتہ وار چھٹی کے مطابق "
"ہوتا ہے، ان برسوں سمیت جب کسی ملک نے اسے بدلا نہیں تھا۔"

msgid "Can I add my company's own days off?"
msgstr "کیا میں اپنی کمپنی کی چھٹیاں خود شامل کر سکتا ہوں؟"

#
msgid ""
"Yes. A company calendar merges any countries and regions with your closures, "
"half days and extra working days, and the API, feeds and webhooks answer "
"from it."
msgstr ""
"جی ہاں۔ کمپنی کیلنڈر کسی بھی ملک اور علاقے کو آپ کی بندشوں، آدھے دنوں اور "
"اضافی کام کے دنوں کے ساتھ ملاتا ہے، اور API، فیڈز اور ویب ہُکس اسی سے جواب "
"دیتے ہیں۔"

msgid "Is there a free plan?"
msgstr "کیا کوئی مفت پلان ہے؟"

msgid ""
"Yes, free for good: 10,000 API requests a month, company calendars, iCal "
"feeds, digests and webhooks. Pro raises the limits."
msgstr ""
"جی ہاں، ہمیشہ کے لیے مفت: ماہانہ 10,000 API درخواستیں، کمپنی کیلنڈر، iCal "
