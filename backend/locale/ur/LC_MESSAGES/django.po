msgstr "آج عام تعطیل والے ممالک"

msgid "Try it"
msgstr "آزمائیں"

msgid "Is it a working day?"
msgstr "کیا یہ کام کا دن ہے؟"

msgid "Ask the same engine the API uses. No account needed."
msgstr "وہی انجن آزمائیں جو API استعمال کرتا ہے۔ اکاؤنٹ کی ضرورت نہیں۔"

msgid "Country"
msgstr "ملک"

msgid "Date"
msgstr "تاریخ"

msgid "Check"
msgstr "جانچیں"

msgid "Yes, it's a working day."
msgstr "جی ہاں، یہ کام کا دن ہے۔"

msgid "No, it's a day off."
msgstr "نہیں، یہ چھٹی کا دن ہے۔"

#, python-format
msgid "%(day)s in %(country)s is %(reason)s."
msgstr "%(country)s میں %(day)s %(reason)s ہے۔"

msgid "Everything a calendar of working days needs"
msgstr "کام کے دنوں کے کیلنڈر کو جو کچھ چاہیے"

msgid ""
"Merge several countries and regions with your own closures, half days and "
"extra working days. Office in Karachi, team in Riyadh? One calendar."
msgstr ""
"کئی ممالک اور علاقوں کو اپنی بندشوں، آدھے دنوں اور اضافی کام کے دنوں کے ساتھ "
"ملائیں۔ دفتر کراچی میں، ٹیم ریاض میں؟ ایک ہی کیلنڈر۔"

msgid "Business-day maths"
msgstr "کاروباری دنوں کا حساب"

msgid ""
"Add or subtract working days and count them between two dates, with each "
"country's own weekend."
msgstr ""
"ہر ملک کی اپنی ہفتہ وار چھٹی کے ساتھ کام کے دن جمع یا تفریق کریں اور دو "
"تاریخوں کے درمیان گنیں۔"

msgid "iCal feeds"
msgstr "iCal فیڈز"

msgid ""
"Subscribe from Google Calendar, Outlook or Apple Calendar with a private, "
"revocable link."
msgstr ""
"نجی اور منسوخ کیے جا سکنے والے لنک کے ذریعے گوگل کیلنڈر، آؤٹ لک یا ایپل "
"کیلنڈر میں سبسکرائب کریں۔"

msgid "Monthly digests"
msgstr "ماہانہ خلاصے"

msgid ""
"An email on the 1st with the next 30 days of holidays, in English, Urdu or "
"Arabic."
msgstr ""
"ہر ماہ کی پہلی تاریخ کو اگلے 30 دنوں کی تعطیلات کی ای میل، انگریزی، اردو یا "
"عربی میں۔"

msgid "Signed webhooks"
msgstr "دستخط شدہ ویب ہُکس"

msgid ""
"HMAC-signed events when calendars change, with retries and a delivery log."
msgstr ""
"کیلنڈر بدلنے پر HMAC دستخط شدہ ایونٹس، دوبارہ کوشش اور ترسیل کے ریکارڈ کے "
"ساتھ۔"

msgid "API keys with plans and quotas"
msgstr "پلان اور حدود کے ساتھ API کلیدیں"

msgid ""
"Per-key rate limits, a monthly quota and a usage chart, so you always know "
"where you stand."
msgstr ""
"ہر کلید کی شرح کی حد، ماہانہ کوٹا اور استعمال کا چارٹ، تاکہ آپ ہمیشہ اپنی "
"صورتحال جانیں۔"

#
msgid "Weekends"
msgstr "ہفتہ وار چھٹیاں"

msgid "The weekend isn't the same everywhere"
msgstr "ہفتہ وار چھٹی ہر جگہ ایک جیسی نہیں"

msgid ""
"A tool that assumes Saturday and Sunday gets payroll wrong in a dozen "
"countries. HolidayOps uses each country's own weekend, from the library's "
"rules."
msgstr ""
"جو ٹول ہفتہ اور اتوار فرض کر لے، وہ درجن بھر ملکوں میں تنخواہ کا حساب غلط کر "
"دیتا ہے۔ HolidayOps لائبریری کے اصولوں سے ہر ملک کی اپنی ہفتہ وار چھٹی "
"استعمال کرتا ہے۔"

msgid "Weekend patterns by number of countries"
msgstr "ممالک کی تعداد کے لحاظ سے ہفتہ وار چھٹی کے انداز"

#
msgid "Countries"
msgstr "ممالک"

#
msgid "Weekend days"
msgstr "ہفتہ وار چھٹی کے دن"

msgid "For example"
msgstr "مثلاً"

msgid "Who it's for"
msgstr "کس کے لیے"

msgid "Built for the teams that count days"
msgstr "ان ٹیموں کے لیے جو دن گنتی ہیں"

msgid "Payroll"
msgstr "تنخواہیں"

msgid "Count the working days in a pay period for every country you pay in."
msgstr ""
"ہر اُس ملک کے لیے تنخواہ کی مدت کے کام کے دن گنیں جہاں آپ ادائیگی کرتے ہیں۔"

msgid "HR and leave"
msgstr "ایچ آر اور چھٹیاں"

msgid "Work out leave days without counting holidays or the local weekend."
msgstr "تعطیلات اور مقامی ہفتہ وار چھٹی گنے بغیر چھٹی کے دن نکالیں۔"

msgid "Logistics"
msgstr "لاجسٹکس"

msgid "Promise delivery dates that skip closures at both ends of the route."
msgstr ""
"ایسی ترسیل کی تاریخیں دیں جو راستے کے دونوں سروں کی بندشوں کو چھوڑ دیں۔"

msgid "Finance"
msgstr "مالیات"

msgid "Settle on the next business day in the right market, every time."
msgstr "ہر بار درست مارکیٹ کے اگلے کاروباری دن پر ادائیگی طے کریں۔"

msgid "How it works"
msgstr "یہ کیسے کام کرتا ہے"

msgid "From sign-up to answers in three steps"
msgstr "سائن اپ سے جواب تک تین مراحل میں"

msgid "Pick your countries"
msgstr "اپنے ممالک چنیں"

msgid ""
"Choose countries, regions and holiday categories. Weekends come from each "
"country's own rules."
msgstr ""
"ممالک، علاقے اور تعطیلات کی اقسام چنیں۔ ہفتہ وار چھٹیاں ہر ملک کے اپنے "
"اصولوں سے آتی ہیں۔"

msgid "Add your own days"
msgstr "اپنے دن شامل کریں"

msgid "Mark office closures, half days and extra working days on the calendar."
msgstr "کیلنڈر پر دفتر کی بندش، آدھے دن اور اضافی کام کے دن لگائیں۔"

msgid "Ask from anywhere"
msgstr "کہیں سے بھی پوچھیں"

msgid ""
"Call the API with a key, subscribe to the feed, or get a webhook when "
"something changes."
msgstr ""
"کلید کے ساتھ API بلائیں، فیڈ سبسکرائب کریں، یا کچھ بدلنے پر ویب ہُک پائیں۔"

msgid "Coming up"
msgstr "آنے والی"

msgid "The next days off, around the world"
msgstr "دنیا بھر میں اگلی چھٹیاں"

msgid "One request, one clear answer"
msgstr "ایک درخواست، ایک واضح جواب"

msgid ""
"JSON over HTTPS, documented with OpenAPI. Holiday names come back in the "
"language you ask for."
msgstr ""
"HTTPS پر JSON، OpenAPI کے ساتھ دستاویزی۔ تعطیلات کے نام آپ کی مطلوبہ زبان "
"میں آتے ہیں۔"

msgid "Read the API docs"
msgstr "API دستاویزات پڑھیں"

msgid "Questions"
msgstr "سوالات"

msgid "Good questions, short answers"
msgstr "اچھے سوال، مختصر جواب"

#, python-format
msgid ""
"Something else? Write to <a href=\"mailto:"
"%(support_email)s\">%(support_email)s</a>."
msgstr ""
"کچھ اور؟ <a href=\"mailto:%(support_email)s\">%(support_email)s</a> پر لکھیں۔"

msgid "Holidays for every country, every year"
msgstr "ہر ملک کی، ہر سال کی تعطیلات"

#, python-format
msgid "See all %(countries)s countries →"
msgstr "تمام %(countries)s ممالک دیکھیں ←"

msgid "Start free. Upgrade when you grow."
msgstr "مفت شروع کریں۔ بڑھنے پر اپ گریڈ کریں۔"

msgid ""
"The free plan includes company calendars, feeds, digests, webhooks and "
"10,000 API requests a month."
msgstr ""
"مفت پلان میں کمپنی کیلنڈر، فیڈز، خلاصے، ویب ہُکس اور ماہانہ 10,000 API "
"درخواستیں شامل ہیں۔"

msgid "See pricing"
msgstr "قیمتیں دیکھیں"

msgid "Try again"
msgstr "دوبارہ کوشش کریں"

msgid ""
"Every plan has the full product: company calendars, iCal feeds, digests and "
"webhooks. Plans only differ in how much you call the API."
msgstr ""
"ہر پلان میں پوری پروڈکٹ شامل ہے: کمپنی کیلنڈر، iCal فیڈز، ڈائجسٹ اور ویب "
"ہُکس۔ پلانز میں فرق صرف اتنا ہے کہ آپ API کتنا استعمال کرتے ہیں۔"

msgid "Pro"
msgstr "پرو"

msgid "For production"
msgstr "پروڈکشن کے لیے"

msgid "Talk to us"
msgstr "ہم سے بات کریں"

msgid "Free forever"
msgstr "ہمیشہ مفت"

msgid "For products that check working days on every request."
msgstr "ان پروڈکٹس کے لیے جو ہر درخواست پر کام کے دن جانچتی ہیں۔"

msgid "For trying the API and small internal tools."
msgstr "API آزمانے اور چھوٹے اندرونی ٹولز کے لیے۔"

msgid "per minute, per key"
msgstr "فی منٹ، فی کلید"

msgid "requests a month"
msgstr "درخواستیں ماہانہ"

msgid "API keys"
msgstr "API کلیدیں"

msgid "Company calendars with your own closures"
msgstr "آپ کی اپنی بندشوں کے ساتھ کمپنی کیلنڈر"

msgid "Private iCal feeds and monthly digests"
msgstr "نجی iCal فیڈز اور ماہانہ ڈائجسٹ"

msgid "Signed webhooks with retries"
msgstr "دوبارہ کوشش کے ساتھ دستخط شدہ ویب ہُکس"

msgid "English, Urdu and Arabic"
msgstr "انگریزی، اردو اور عربی"

msgid "Contact us to upgrade."
msgstr "اپ گریڈ کے لیے ہم سے رابطہ کریں۔"

msgid "How requests are counted"
msgstr "درخواستیں کیسے گنی جاتی ہیں"

msgid "One call, one request"
msgstr "ایک کال، ایک درخواست"

msgid ""
"Each API call made with a key counts once. Public pages, the playground and "
"your iCal feeds don't count."
msgstr ""
"کلید کے ساتھ کی گئی ہر API کال ایک بار گنی جاتی ہے۔ عوامی صفحات، پلے گراؤنڈ "
"اور آپ کی iCal فیڈز نہیں گنی جاتیں۔"

msgid "A per-minute limit for each key"
msgstr "ہر کلید کے لیے فی منٹ حد"

msgid ""
"Bursts are smoothed per key, so one busy service can't use up another's "
"allowance."
msgstr ""
"اچانک بڑھنے والی درخواستیں ہر کلید پر الگ سنبھالی جاتی ہیں، اس لیے ایک مصروف "
"سروس دوسری کا حصہ ختم نہیں کر سکتی۔"

msgid "A monthly quota for the organization"
msgstr "ادارے کے لیے ماہانہ کوٹا"

msgid ""
"All keys share it. It resets on the 1st of each month, and your usage chart "
"shows where you stand."
msgstr ""
"سب کلیدیں اسے بانٹتی ہیں۔ یہ ہر مہینے کی پہلی تاریخ کو دوبارہ شروع ہوتا ہے، "
"اور استعمال کا چارٹ بتاتا ہے کہ آپ کہاں ہیں۔"

msgid "Over the limit?"
msgstr "حد سے تجاوز؟"

msgid ""
"You get <code>429 Too Many Requests</code> with a <code>Retry-After</code> "
"header. Nothing is billed and nothing breaks."
msgstr ""
"آپ کو <code>Retry-After</code> ہیڈر کے ساتھ <code>429 Too Many Requests</"
"code> ملتا ہے۔ نہ کوئی بل بنتا ہے، نہ کچھ ٹوٹتا ہے۔"

msgid "Compare plans"
msgstr "پلانز کا موازنہ"

msgid "Feature"
msgstr "خصوصیت"

msgid "Requests per minute, per key"
msgstr "فی کلید، فی منٹ درخواستیں"

msgid "Requests a month"
msgstr "ماہانہ درخواستیں"

msgid "Included"
msgstr "شامل"

msgid "Do the public holiday pages count against my quota?"
msgstr "کیا عوامی تعطیلات کے صفحات میرے کوٹے میں گنے جاتے ہیں؟"

msgid ""
"No. Only API calls made with one of your keys count. Browsing holidays, the "
"playground and calendar feeds are free."
msgstr ""
"نہیں۔ صرف آپ کی کسی کلید سے کی گئی API کالز گنی جاتی ہیں۔ تعطیلات دیکھنا، "
"پلے گراؤنڈ اور کیلنڈر فیڈز مفت ہیں۔"

msgid ""
"From the open-source holidays library, kept up to date by its community. "
"Your company closures stay in your own calendars."
msgstr ""
"اوپن سورس holidays لائبریری سے، جسے اس کی کمیونٹی تازہ رکھتی ہے۔ آپ کی کمپنی "
"کی بندشیں آپ کے اپنے کیلنڈروں میں رہتی ہیں۔"

msgid "Can I change plans later?"
msgstr "کیا میں بعد میں پلان بدل سکتا ہوں؟"

msgid ""
"Yes. Your calendars, feeds and keys stay as they are; only the limits change."
msgstr ""
"جی ہاں۔ آپ کے کیلنڈر، فیڈز اور کلیدیں ویسی ہی رہتی ہیں؛ صرف حدیں بدلتی ہیں۔"

msgid "Which languages are supported?"
msgstr "کون سی زبانیں دستیاب ہیں؟"

msgid ""
"The app, the emails and holiday names come in English, Urdu and Arabic, with "
"right-to-left layouts."
msgstr ""
"ایپ، ای میلز اور تعطیلات کے نام انگریزی، اردو اور عربی میں ہیں، دائیں سے "
"بائیں ترتیب کے ساتھ۔"

msgid "Public holidays"
msgstr "عام تعطیلات"

msgid "Working days"
msgstr "کام کے دن"

msgid "No public holidays this year."
msgstr "اس سال کوئی عام تعطیل نہیں۔"

msgid "Other years"
msgstr "دوسرے سال"

#, python-format
msgid "All of %(country)s"
msgstr "پورا %(country)s"

msgid "Regions"
msgstr "علاقے"

msgid "Use these dates in your software"
msgstr "یہ تاریخیں اپنے سافٹ ویئر میں استعمال کریں"

msgid ""
"Check working days, add business days and merge countries with your own "
"company closures through the HolidayOps API."
msgstr ""
"HolidayOps API کے ذریعے کام کے دن جانچیں، کاروباری دن جمع کریں اور ممالک کو "
"اپنی کمپنی کی چھٹیوں کے ساتھ ملائیں۔"

msgid "Get an API key"
msgstr "API کلید حاصل کریں"

msgid "Too many requests. Wait a minute and try again."
msgstr "بہت زیادہ درخواستیں۔ ایک منٹ رکیں اور دوبارہ کوشش کریں۔"

msgid "Public holidays by country"
msgstr "ملک کے لحاظ سے عام تعطیلات"

#, python-format
msgid ""
"Public holidays and working days for %(count)s countries, with the dates for "
"every year."
msgstr ""
"%(count)s ممالک کی عام تعطیلات اور کام کے دن، ہر سال کی تاریخوں کے ساتھ۔"

#, python-format
msgid "Public holidays in %(place)s %(year)s"
msgstr "%(place)s میں %(year)s کی عام تعطیلات"

#, python-format
msgid "%(place)s holidays %(year)s"
msgstr "%(place)s کی تعطیلات %(year)s"

#, python-format
msgid ""
"All %(count)s public holidays in %(place)s in %(year)s, with dates, weekdays "
"and %(working)s working days."
msgstr ""
"%(place)s میں %(year)s کی تمام %(count)s عام تعطیلات، تاریخوں، دنوں اور "
"%(working)s کام کے دنوں کے ساتھ۔"

msgid "Pricing: free and Pro API plans"
msgstr "قیمتیں: مفت اور Pro API پلان"

msgid ""
"Start free with 10,000 API requests a month. Every plan includes company "
"calendars, iCal feeds, digests and webhooks."
msgstr ""
"ماہانہ 10,000 API درخواستوں کے ساتھ مفت شروع کریں۔ ہر پلان میں کمپنی کیلنڈر، "
"iCal فیڈز، خلاصے اور ویب ہُکس شامل ہیں۔"

msgid "Usage chart"
msgstr "استعمال کا چارٹ"

msgid "Webhook URLs must use https."
msgstr "ویب ہُک URL میں https ہونا لازمی ہے۔"

msgid "Webhook URLs must not contain credentials."
msgstr "ویب ہُک URL میں لاگ اِن کی معلومات نہیں ہونی چاہئیں۔"

msgid "Webhook URL has no host."
msgstr "ویب ہُک URL میں ہوسٹ موجود نہیں۔"

msgid "Webhook URL has an invalid port."
msgstr "ویب ہُک URL کا پورٹ درست نہیں۔"

msgid "Webhook host does not resolve."
msgstr "ویب ہُک ہوسٹ کا پتہ نہیں مل سکا۔"

msgid "Webhook host must resolve to public addresses only."
msgstr "ویب ہُک ہوسٹ کو صرف عوامی پتوں پر ہونا چاہیے۔"

#, python-format
msgid "An organization can have at most %(max)s webhooks."
msgstr "ایک تنظیم کے زیادہ سے زیادہ %(max)s ویب ہُکس ہو سکتے ہیں۔"

msgid "Page not found"
msgstr "صفحہ نہیں ملا"

msgid "This page doesn't exist."
msgstr "یہ صفحہ موجود نہیں ہے۔"
