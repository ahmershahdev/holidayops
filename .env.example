# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL
MYSQL_DATABASE=holidayops
MYSQL_USER=holidayops
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Production only: Azure MySQL needs TLS (REQUIRED or VERIFY_IDENTITY); optional CA bundle path
MYSQL_SSL_MODE=
MYSQL_SSL_CA=

# Redis (prod cache, throttles, Celery broker)
REDIS_URL=redis://127.0.0.1:6379/0

# Production only: set to false just to run the production image over plain HTTP locally
DJANGO_HTTPS=true
LOG_LEVEL=INFO
# Proxies in front of Django (1 behind Azure Container Apps); 0 locally
NUM_PROXIES=0

# App URL used in emails (links back to the web app)
APP_URL=http://localhost:5173

# Email: console backend prints mail to the terminal; use smtp in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=HolidayOps <no-reply@holidayops.test>

# API
API_ANON_RATE=60/minute
API_USER_RATE=600/minute
API_AUTH_RATE=10/minute
API_INVITE_RATE=30/hour

# Plans (API keys): per-key rate, monthly requests per org, active keys
PLAN_FREE_RATE=120/minute
PLAN_FREE_QUOTA=10000
PLAN_FREE_KEYS=3
PLAN_PRO_RATE=1200/minute
PLAN_PRO_QUOTA=1000000
PLAN_PRO_KEYS=20

# Demo data (npm run seed, development only)
DEMO_PASSWORD=change-me-demo
